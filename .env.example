# Required
DeepSeek_API_KEY=
DeepSeek_Coding_URL=

# Required internal DashScope channels for VLM, knowledge-base search, and embeddings
DASHSCOPE_API_KEY=
DASHSCOPE_Qwen_plus_KEY=
DASHSCOPE_Qwen_plus_URL=

# Optional runtime settings
NTL_TOOL_PROFILE=default
NTL_USER_DATA_DIR=
NTL_SHARED_DATA_DIR=
NTL_THREAD_ID=
NTL_CONTEXTILY_TMP=
NTL_FORCE_NATIVE_CHAT_INPUT=1
NTL_USE_CUSTOM_MULTIMODAL_CHAT_INPUT=0
NTL_VLM_MODEL=qwen3.5-plus

# PostgreSQL persistence for production deployments
# If NTL_HISTORY_DB_URL is empty, history storage falls back to NTL_LANGGRAPH_POSTGRES_URL.
NTL_HISTORY_DB_URL=
NTL_LANGGRAPH_POSTGRES_URL=

# Runtime safety limits. Use 0 to disable a limit.
NTL_MAX_ACTIVE_RUNS=10
NTL_MAX_ACTIVE_RUNS_PER_USER=2
NTL_THREAD_WORKSPACE_QUOTA_MB=500
NTL_USER_WORKSPACE_QUOTA_MB=1024

# Public geopolitical web service. Use a long random value in production.
# When exposed through an HTTPS domain tunnel, set NTL_WEB_COOKIE_SECURE=1.
NTL_WEB_SESSION_SECRET=
NTL_WEB_COOKIE_SECURE=0
NTL_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,geointer.geosetting-ai.com
NTL_WEB_HOST=127.0.0.1
NTL_WEB_PORT=8502
NTL_WEB_MAX_UPLOAD_MB=200



# Background global geopolitical event monitor. All sessions read the same persisted snapshot.
NTL_MONITOR_ENABLED=0
# Optional explicit directory; defaults to <NTL_USER_DATA_DIR>/_monitor.
NTL_MONITOR_DATA_DIR=
NTL_MONITOR_INTERVAL_MINUTES=30
NTL_MONITOR_EVENT_TTL_HOURS=168
NTL_MONITOR_MAX_EVENTS_PER_SOURCE=10
NTL_MONITOR_REQUEST_TIMEOUT_S=22
NTL_MONITOR_DEEPAGENT_ENABLED=1
NTL_MONITOR_MODEL=deepseek-v4-flash
NTL_MONITOR_AGENT_TIMEOUT_S=80
NTL_MONITOR_GDELT_ENABLED=1
NTL_MONITOR_GDELT_QUERY=conflict OR protest OR sanctions OR blockade
# Optional ACLED conflict source. ACLED uses OAuth; leave all values empty to skip it.
NTL_MONITOR_ACLED_ENABLED=0
NTL_MONITOR_ACLED_ACCESS_TOKEN=
NTL_MONITOR_ACLED_USERNAME=
NTL_MONITOR_ACLED_PASSWORD=
NTL_MONITOR_ACLED_LOOKBACK_DAYS=7

# Optional external services
GEE_DEFAULT_PROJECT_ID=
EARTHDATA_TOKEN=
amap_api_key=

# Optional local stdio MCP runtime
NTL_MCP_ENV_FILE=
NTL_MCP_WORKDIR=
NTL_MCP_STATE_DIR=.ntl-mcp

# RAG / knowledge-base embeddings. DashScope is the default provider.
NTL_EMBEDDING_PROVIDER=dashscope
NTL_EMBEDDING_MODEL=text-embedding-v4
NTL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NTL_EMBEDDING_DIMENSIONS=1024
# Optional override; if empty, DASHSCOPE_Qwen_plus_KEY is used for DashScope embeddings.
NTL_EMBEDDING_API_KEY=
# Optional only if you explicitly set NTL_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Optional only if you use Google BigQuery features
# GOOGLE_APPLICATION_CREDENTIALS=
