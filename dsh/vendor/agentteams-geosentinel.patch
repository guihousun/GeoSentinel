+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {registerAgentTeamsTools} from '../lib/tools.js';
+import {queueSubagentPrompt} from '@deepseek-ai/dsh-subagent/internal';
+import {deliverToMember,installRetiredMemberGuard} from '../lib/members.js';
+import {recordRetiredMemberIds} from '../lib/state.js';
+
+test('managed production tools enforce roles, approval and specialist-only handoff',async t=>{
+  const workspace=await mkdtemp(join(tmpdir(),'geosentinel-teams-'));
+  t.after(()=>rm(workspace,{recursive:true,force:true}));
+  const definitions=new Map(),live=new Map(),spawned=[];
+  const makeAgent=(id,parentSession)=>({id,status:'idle',options:{provider:'test',model:'test'},
+    session:{id,header:{cwd:workspace,parentSession},events:[],append(){},requestHeader(){return {config:{provider:'test',model:'test'}};}},
+    steer(){},inject(){},cancel(){},whenIdle(){return Promise.resolve();}});
+  const captain=makeAgent('captain-session');live.set(captain.id,captain);
+  const ctx={effect:fn=>fn(),on:()=>()=>{},emit(){},tools:{register:d=>definitions.set(d.name,d)},
+    agents:{get:id=>live.get(id)},logger:{warn(){},debug(){}},
+    llm:{resolveCallConfig:async c=>c,listModels:async()=>[]},
+    subagents:{registerContinuableSetup:()=>()=>{},getProvider:()=>({prepareContinuable(){},capabilities:{persona:true,toolFilter:true}}),
+      list:()=>['spawn'],startContinuable:async spec=>{spawned.push(spec);const id=`child-${spawned.length}`;live.set(id,makeAgent(id,captain.id));return {childId:id};},
+      listChildren:async()=>[],listDescendants:async()=>[],[queueSubagentPrompt]:async()=> 'message',interrupt(){}}};
+  const runtime=registerAgentTeamsTools(ctx,{stateDir:'.agent-teams',memberProvider:'spawn',memberMaxDepth:1,maxMembers:3,
+    profiles:{},geosentinel:true,roleTools:{NTL_Data_Searcher:['geo_download_gee'],NTL_Analyst:['geo_execute_python']}});
+  const call=(name,args,agent=captain)=>definitions.get(name).execute(args,{agent,signal:new AbortController().signal});
+  const created=await call('agent_teams_create',{name:'research',approval:'automatic'});
+  assert.equal(created.phase,'staged');assert.equal(spawned.length,0);
+  await assert.rejects(()=>call('agent_teams_add_member',{name:'arbitrary-admin'}),/not allowed|must be one of/);
+  await assert.rejects(()=>call('agent_teams_add_member',{name:'NTL_Analyst',model:'unapproved'}),/administrator-owned|unknown|unexpected|not allowed/i);
+  await call('agent_teams_add_member',{name:'NTL_Data_Searcher'});
+  await call('agent_teams_add_member',{name:'NTL_Analyst'});
+  await call('agent_teams_create_task',{subject:'Acquire observations',assignee:'NTL_Data_Searcher'});
+  await assert.rejects(()=>call('agent_teams_claim_task',{task_id:'t1'}),/awaiting user confirmation/);
+  await assert.rejects(()=>call('agent_teams_approve',{confirmation:'I approve myself'}),/authenticated user/);
+  await assert.rejects(()=>runtime.updateStagedPlan(captain,'research',{action:'update_member',memberName:'NTL_Analyst',provider:'other',model:'other'}),/cannot be edited/);
+  await assert.rejects(()=>runtime.approveStagedTeam(captain,'research',undefined,'outdated'),/plan changed/);
+  await runtime.approveStagedTeam(captain,'research',undefined,(await runtime.inspectTeam(captain)).approvalRevision);
+  assert.equal(spawned.length,2);
+  await assert.rejects(()=>call('agent_teams_create_task',{subject:'Unapproved scope',assignee:'NTL_Analyst'}),/new staged plan/);
+  await assert.rejects(()=>call('agent_teams_add_member',{name:'NTL_Event_Tracker'}),/new staged plan/);
+  for(const spec of spawned){assert.equal(spec.request.maxDepth,1);assert.ok(spec.request.toolFilter.allow.includes('agent_teams_claim_task'));assert.ok(!spec.request.toolFilter.allow.includes('subagent'));}
+  assert.ok(spawned[0].request.toolFilter.allow.includes('geo_download_gee'));
+  assert.ok(!spawned[0].request.toolFilter.allow.includes('geo_execute_python'));
+  await assert.rejects(()=>call('agent_teams_send_message',{to:'NTL_Analyst',content:'Do my task'},live.get('child-1')),/peer messaging is disabled/);
+  await assert.rejects(()=>call('agent_teams_reassign_task',{task_id:'t1',assignee:'captain',reason:'too slow'}),/cannot take over/);
+});
+
+test('rc.1 host queue preserves FIFO provenance and rejects retired members',async t=>{
+  const workspace=await mkdtemp(join(tmpdir(),'geosentinel-queue-'));
+  t.after(()=>rm(workspace,{recursive:true,force:true}));
+  const received=[],disposers=[];
+  const original=async (...args)=>{received.push(args);return 'message-id';};
+  const runtime={[queueSubagentPrompt]:original};
+  const ctx={subagents:runtime,effect(fn){disposers.push(fn());},logger:{warn(){}}};
+  const captain={session:{header:{cwd:workspace}}};
+  const signal=new AbortController().signal;
+  installRetiredMemberGuard(ctx,'.agent-teams');
+  assert.equal(await deliverToMember(ctx,captain,'active-child','test message',signal),true);
+  assert.equal(received[0][0],captain);
+  assert.deepEqual(received[0][3],{kind:'plugin',plugin:'dsh-agent-teams'});
+  assert.equal(received[0][4],signal);
+  await recordRetiredMemberIds(join(workspace,'.agent-teams'),['retired-child']);
+  assert.equal(await deliverToMember(ctx,captain,'retired-child','must not run',signal),false);
+  assert.equal(received.length,1);
+  assert.equal(await deliverToMember(ctx,captain,'other-child','still allowed',signal),true);
+  for(const dispose of disposers)dispose();
+  assert.equal(runtime[queueSubagentPrompt],original);
+});
