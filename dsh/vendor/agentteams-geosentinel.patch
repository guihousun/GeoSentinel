@@ -0,0 +1,55 @@
+/** Product policy: server-owned roles, no peer delegation, explicit plan consent. */
+import { createHash } from 'node:crypto'
+import type { TeamState } from './types.ts'
+
+export function geoPlanRevision(team: TeamState): string {
+  return createHash('sha256').update(JSON.stringify({description:team.description,members:team.members,tasks:team.tasks})).digest('hex')
+}
+
+export const GEO_ROLES = {
+  NTL_Data_Searcher: '数据助手：负责数据获取、标准预处理、质量与来源，返回可分析数据。',
+  NTL_Analyst: '分析助手：负责空间和时序方法、受控执行、产物验证与分析结果。',
+  NTL_Event_Tracker: '事件助手：负责事件来源、时间线、冲突信息与证据限制。',
+} as const
+
+export type GeoRole = keyof typeof GEO_ROLES
+
+/** Keep the upstream implementation signature while hiding administrator-only schema fields. */
+export function geoMemberParameters<const T extends { name: object }>(managed: boolean | undefined, parameters: T): T {
+  return managed ? { name: { ...parameters.name, enum: Object.keys(GEO_ROLES) } } as T : parameters
+}
+
+export function geoRole(name: string): GeoRole {
+  if (!Object.hasOwn(GEO_ROLES, name)) throw new Error(`GeoSentinel role is not allowed: ${name}`)
+  return name as GeoRole
+}
+
+export function assertGeoMemberOptions(options: {
+  provider?: unknown; model?: unknown; reasoning_effort?: unknown; executionPrompt?: unknown;
+}): void {
+  if (Object.values(options).some(value => value !== undefined)) {
+    throw new Error('GeoSentinel member configuration is administrator-owned')
+  }
+}
+
+export function assertGeoMessage(from: string, to: string): void {
+  if (from !== 'captain' && to !== 'captain') {
+    throw new Error('GeoSentinel specialists must return to the supervisor; peer messaging is disabled')
+  }
+}
+
+export const GEO_USAGE = `You are the GeoSentinel supervisor (地缘分析师).
+Answer simple questions directly. For multi-step research, create a staged team and a concise plan
+covering AOI, dates, sources, method, expected artifacts and material uncertainty. Wait for user approval.
+Only NTL_Data_Searcher, NTL_Analyst and NTL_Event_Tracker are allowed; add only needed roles.
+Do not supply a model, provider or execution prompt when adding a member. Those are administrator-owned.
+Only the supervisor assigns work. Specialists return results or revision needs to the supervisor.
+Never duplicate a specialist's work or take over its task just because it has not finished yet.
+After assigning or approving work, end your turn and let the scheduler run. Do not busy-poll status.
+Use Chinese for user-facing explanations and member reports.
+Use existing domain tools and role skills. Preserve scientific scope, provenance and artifact validation.
+The user interface owns approval; never call agent_teams_approve to approve your own plan.
+Report real progress and evidence. Never claim success before the artifacts and checks are available.
+Do not describe a second run of the same method as independent scientific validation.
+Do not invent accuracy, resampling semantics, uncertainty bounds or coverage claims absent source evidence.
+Never access host files, credentials, plugin configuration or another project's workspace.`
