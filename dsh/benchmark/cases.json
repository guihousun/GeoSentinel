{
  "schema": "geosentinel.benchmark.v1",
  "name": "地缘环境智能计算基准（30 例）",
  "description": "参考 NTL-GPT 回归清单（.ntl-gpt/skills/ntl-regression-evaluation/references/regression-checklist.json，工作区内没有 200 例原始集）抽取与地缘环境智能计算相关的题型，再补充平台典型场景。分三档难度，全部通过普通用户模式的产品接口真实执行。",
  "tiers": {
    "基础": "单步或两步；期望工具、产物与关键词明确。",
    "进阶": "多步或多角色；需要真实数据获取、统计与证据链。",
    "挑战": "含口径、时区、归因、无数据或来源冲突等约束，重点考查是否如实报告限制。"
  },
  "cases": [
    {
      "id": "B01",
      "tier": "基础",
      "title": "上海 2020 年分区 ANTL 统计",
      "prompt": "请获取上海市 2020 年度夜间灯光，并统计各区（区级行政区）的 ANTL 均值，按均值从高到低排序输出表格。",
      "expect": {
        "tools": [
          "geo_download_boundary",
          "geo_calculate_zonal_statistics"
        ],
        "artifacts": [
          ".csv"
        ],
        "keywords": [
          "黄浦",
          "崇明"
        ],
        "forbidden": [
          "无法获取"
        ]
      },
      "timeoutMinutes": 45
    },
    {
      "id": "B02",
      "tier": "基础",
      "title": "单幅栅格质量检查",
      "prompt": "请先获取一幅上海 2020 年度夜间灯光栅格，然后检查它的网格、CRS、有效像元数与数值范围，说明它能否直接用于分区统计。",
      "expect": {
        "tools": [
          "geo_inspect_raster"
        ],
        "keywords": [
          "像元",
          "CRS"
        ],
        "forbidden": []
      },
      "timeoutMinutes": 25
    },
    {
      "id": "B03",
      "tier": "基础",
      "title": "中国省级边界获取与核验",
      "prompt": "获取湖北省的下级地级行政区边界，报告区数与名称，并说明来源。",
      "expect": {
        "tools": [
          "geo_download_boundary"
        ],
        "keywords": [
          "武汉",
          "区"
        ],
        "forbidden": [
          "整市面"
        ]
      },
      "timeoutMinutes": 15
    },
    {
      "id": "B04",
      "tier": "基础",
      "title": "逐年 ANTL 时间序列",
      "prompt": "计算上海市 2015—2020 年逐年 ANTL 均值，给出时间序列表并说明变化方向。",
      "expect": {
        "tools": [
          "geo_calculate_zonal_statistics"
        ],
        "keywords": [
          "2015",
          "2020"
        ],
        "forbidden": []
      },
      "timeoutMinutes": 45
    },
    {
      "id": "B05",
      "tier": "基础",
      "title": "等距缓冲区",
      "prompt": "请写出仰光港中心点（纬度 16.80、经度 96.15）为点文件，再生成 50 公里缓冲区，说明所用投影与半径单位，并输出矢量文件。",
      "expect": {
        "tools": [
          "geo_buffer_points_aeqd"
        ],
        "artifacts": [
          ".geojson"
        ],
        "keywords": [
          "50",
          "缓冲"
        ],
        "forbidden": []
      },
      "timeoutMinutes": 20
    },
    {
      "id": "B06",
      "tier": "基础",
      "title": "按多边形筛选点",
      "prompt": "请先构造仰光港、上海港、宁波舟山港三个港口点位（写出点文件），再按上海市域边界筛选，报告落在市域内的点数与名称。",
      "expect": {
        "tools": [
          "geo_filter_points_by_polygon"
        ],
        "keywords": [
          "上海"
        ],
        "forbidden": []
      },
      "timeoutMinutes": 20
    },
    {
      "id": "B07",
      "tier": "基础",
      "title": "栅格重投影",
      "prompt": "请先获取一幅上海 2020 年度夜间灯光栅格，再把它重投影到 EPSG:3857，说明对连续型数据采用的重采样方法。",
      "expect": {
        "tools": [
          "geo_reproject_raster"
        ],
        "keywords": [
          "3857"
        ],
        "forbidden": []
      },
      "timeoutMinutes": 20
