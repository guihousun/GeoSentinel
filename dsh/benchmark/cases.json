    {
      "id": "A03",
      "tier": "进阶",
      "title": "月度时间序列选型",
      "prompt": "计算上海 2020 年每个月的平均夜间灯光并输出时间序列表。",
      "expect": {
        "tools": [],
        "keywords": [
