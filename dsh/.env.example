# Dedicated GeoSentinel configuration. Never commit .env or credential files.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEE_DEFAULT_PROJECT_ID=
GEO_GEE_CREDENTIALS=
# 高德开放平台密钥：供「外部地理服务（远程 MCP）」的地址↔坐标、POI、距离与路径规划使用。
# 服务端持有，仅管理员配置；不配置则高德 MCP 的工具不会出现，其余功能不受影响。
# （中国行政区按六位 adcode 下载不需要该密钥。）
AMAP_API_KEY=
# Shared data library: public use-case data, downloaded global boundaries,
# imagery, GDP and reference packs (e.g. 《缅甸地理》). Read-only everywhere, and
# mounted read-only into the analysis container, so large data can be analysed
# without copying it into a project (uploads are capped at 16 MiB per file).
#   GEO_SHARE_DIR   one root, addressed as share/<子路径>
#   GEO_SHARE_DIRS  several names roots, addressed as share/<名称>/<子路径>
# Agents read it as share/…; inside the container it is /workspace/share/…
# GEO_SHARE_DIR=E:/DSH/share
# GEO_SHARE_DIRS="缅甸地理=E:/DSH/缅甸地理"
# Optional separate local administrator DSH home; never share the product home.
GEO_ADMIN_HOME=
# Optional release state/snapshots directory; default is GEO_DSH_HOME/releases.
GEO_RELEASE_DIR=
# Optional acquisition-only proxy, e.g. http://host.docker.internal:7897
GEO_GEE_PROXY=
# Optional absolute checkout path to the independent AgentTeams fork.
# GEO_AGENT_TEAMS_DIR=
# Set only when overriding the default isolated .runtime/home directory.
# GEO_DSH_HOME=
# GEO_DATA_DIR=
# Local testing only. For an HTTPS reverse proxy, set the public host and true.
GEO_ALLOWED_HOSTS=127.0.0.1:8510,localhost:8510
GEO_SECURE_COOKIES=false

# Automatic queues: active research chats / Docker jobs (not online users).
GEO_RESEARCH_CONCURRENCY=10
GEO_USER_RESEARCH_CONCURRENCY=2
GEO_DOCKER_CONCURRENCY=10
GEO_USER_DOCKER_CONCURRENCY=2
# Per-container RAM in MiB: 3072 = 3 GiB; use 4096 for 4 GiB if capacity permits.
GEO_DOCKER_MEMORY_MIB=3072
# Application-level free disk reserve, not a filesystem hard quota.
GEO_MIN_FREE_DISK_MIB=1024

# Shared public monitor, independent of research sessions and account databases.
GEO_MONITOR_ENABLED=true
GEO_MONITOR_INTERVAL_MINUTES=30
GEO_MONITOR_TRANSLATE=true
GEO_MONITOR_MODEL=deepseek-v4-flash
# GEO_MONITOR_DIR=D:/GeoSentinel-data/monitor
# GEO_MONITOR_PROXY=http://host.docker.internal:7897
# GEO_MONITOR_EXTERNAL=true
NTL_MONITOR_GDELT_ENABLED=true
# ACLED stays disabled until credentials and redistribution permissions are configured.
NTL_MONITOR_ACLED_ENABLED=false

# Optional executable override for authenticated administrator development on Windows.
# GEO_ADMIN_PWSH_PATH=C:/Program Files/PowerShell/7/pwsh.exe
